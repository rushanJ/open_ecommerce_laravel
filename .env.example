# -----------------------------------------------------------------------------
# open_ecommerce_laravel — copy to .env and run: php artisan key:generate
# Never commit real secrets. Replace placeholders before production.
# -----------------------------------------------------------------------------

APP_NAME=open_ecommerce_laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_TIMEZONE=Asia/Colombo
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# Database — create empty schema `open_ecommerce_laravel` in MySQL before first migrate
# -----------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=open_ecommerce_laravel
DB_USERNAME=root
DB_PASSWORD=

# -----------------------------------------------------------------------------
# Mail — for SMTP, set MAIL_SCHEME=tls (or ssl) and fill host/credentials
# -----------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=admin@open-ecommerce-laravel.test
MAIL_FROM_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# Files, sessions, cache, queue
# -----------------------------------------------------------------------------
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
CACHE_STORE=file
SESSION_DRIVER=file
SESSION_LIFETIME=120

VITE_APP_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# Bootstrap admin (used by seeders on fresh install — change before go-live)
# -----------------------------------------------------------------------------
OPEN_ECOMMERCE_LARAVEL_ADMIN_NAME="Super Admin"
OPEN_ECOMMERCE_LARAVEL_ADMIN_EMAIL=admin@open-ecommerce-laravel.test
OPEN_ECOMMERCE_LARAVEL_ADMIN_PASSWORD=password
ADMIN_CREATE_PIN=

# -----------------------------------------------------------------------------
# PayHere (optional — can also be configured in Admin → Settings → Payments)
# -----------------------------------------------------------------------------
PAYHERE_ENABLED=false
PAYHERE_MODE=sandbox
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=

OPEN_ECOMMERCE_LARAVEL_ADMIN_THEME=light
OPEN_ECOMMERCE_LARAVEL_ADMIN_BRAND_NAME=open_ecommerce_laravel
OPEN_ECOMMERCE_LARAVEL_ADMIN_PRIMARY_COLOR=#2563eb
